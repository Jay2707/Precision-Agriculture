# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# MySQL database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=crop_disease_db

# Backend server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Gmail (used to send the welcome email on sign-up)
# Use a Gmail App Password, not your real Gmail password:
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Frontend (Vite) — these must be prefixed with VITE_ to be exposed to the browser
VITE_OPENWEATHER_API_KEY=
VITE_PLANT_ID_API_KEY=

AI_API_KEY=paste_your_groq_key_here
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=openai/gpt-oss-20b